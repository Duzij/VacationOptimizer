    "version": "0.2.0",
    "configurations": [
        {
            "name": "VacationOptimizer.Server Production",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/VacationOptimizer.Server/bin/Release/net10.0/publish/VacationOptimizer.Server.dll",
            "cwd": "${workspaceFolder}/VacationOptimizer.Server",
            "launchSettingsFilePath": "${workspaceFolder}/VacationOptimizer.Server/Properties/launchSettings.json",
            "launchSettingsProfile": "Production",
            "preLaunchTask": "dotnet_build",
        },
        {
            "name": "VacationOptimizer.Server Dev",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/VacationOptimizer.Server/bin/Debug/net10.0/VacationOptimizer.Server.dll",
            "cwd": "${workspaceFolder}/VacationOptimizer.Server",
            "launchSettingsFilePath": "${workspaceFolder}/VacationOptimizer.Server/Properties/launchSettings.json",
            "launchSettingsProfile": "Development",
            "preLaunchTask": "dotnet_build",
        }
    ]
}
